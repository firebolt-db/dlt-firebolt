# Copy to .dlt/secrets.toml (gitignored). Do not commit real credentials.
#
# dlt credential field names differ from Firebolt env var names:
#   host         = Firebolt database name  (FIREBOLT_DATABASE)
#   database     = Firebolt engine name    (FIREBOLT_ENGINE)
#   username     = service account client ID
#   password     = service account secret

# --- Firebolt Core (upload mode, verified) ---

# [destination.firebolt]
# staging_mode = "upload"
# core_url = "http://localhost:3473"
#
# [destination.firebolt.credentials]
# host = "firebolt"
# database = "firebolt"
# account_name = "core"
# query = { url = "http://localhost:3473" }
#
# [destination.filesystem]
# bucket_url = "file:///tmp/dlt-firebolt-staging"

# --- Managed Firebolt (S3 mode) ---

[destination.firebolt]
staging_mode = "s3"
s3_location_name = "your_location_name"
s3_prefix = "dlt-landing"
# Multi-tenant bucket-root LOCATION (PATTERN is relative to this URL):
# s3_location_url = "s3://example-bucket/"
# Env alias: DESTINATION__FIREBOLT__S3_LOCATION_URL

[destination.firebolt.credentials]
host = "YOUR_FIREBOLT_DATABASE"
database = "YOUR_FIREBOLT_ENGINE"
username = "YOUR_CLIENT_ID"
password = "YOUR_CLIENT_SECRET"
account_name = "YOUR_ACCOUNT_NAME"

[destination.filesystem]
bucket_url = "s3://example-bucket/dlt-landing/dlt/staging"
# Multi-tenant: use a tenant-specific bucket_url, e.g.
# bucket_url = "s3://example-bucket/tenant-a/dlt/staging"
